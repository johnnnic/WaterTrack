# Konfigurasi environment untuk Docker development
# File ini aman di-commit ke git — berisi kredensial dev lokal saja, BUKAN production.
# Digunakan oleh docker-compose.yml via env_file: ./backend/.env.docker

APP_NAME=WaterTrack
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Kunci dev stabil agar session tidak invalid saat container restart.
APP_KEY=base64:k3K3KpZ5u7/4z9ZQ+vZZQ4bPpMPM8j5Z9P7ZqPpMq/E=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL — service name "db" sesuai docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=water_billing
DB_USERNAME=watertrack
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
QUEUE_CONNECTION=database

# Redis — service name "redis" sesuai docker-compose.yml
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local

# CORS: izinkan request dari Vite dev server
FRONTEND_URL=http://localhost:3000

BCRYPT_ROUNDS=10

MAIL_MAILER=log
